<Window x:Class="PsiSplit.App.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="App"
        Height="560" Width="660"
        MinHeight="520" MinWidth="620"
        Icon="Assets/PsiSplit.png"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="New app" Style="{StaticResource H1}"/>
            <TextBlock Text="The app will receive the PsiSplit proxy and go through Psiphon in the selected mode."
                       Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                <TextBlock Text="Path to .exe" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Style="{StaticResource InputStyle}"/>
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}"
                            Click="Browse_Click" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="Arguments (optional)" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/>
                <TextBox x:Name="ArgsBox" Style="{StaticResource InputStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="Mode" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                <Border Background="{StaticResource CardAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                    <StackPanel>
                        <RadioButton x:Name="FullModeRadio" GroupName="Mode" IsChecked="True"
                                     Content="All traffic through the VPN (Full proxy)" Margin="0,0,0,8"/>
                        <RadioButton x:Name="FilteredModeRadio" GroupName="Mode"
                                     Content="Listed sites only (Filtered proxy)"/>
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Muted}" FontSize="11"
                           Text="For Chrome/Edge, --proxy-server is added to the arguments automatically if it is not already there."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" MinWidth="120" IsDefault="True"/>
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"
                    Margin="8,0,0,0" MinWidth="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
