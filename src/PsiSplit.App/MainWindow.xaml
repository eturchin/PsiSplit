<Window x:Class="PsiSplit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PsiSplit — Selective VPN"
        Height="780" Width="1100" MinHeight="680" MinWidth="960"
        Icon="Assets/PsiSplit.png"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================= TOOLBAR ============================= -->
        <Border Grid.Row="0" Background="#10151E" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Width="44" Height="44" Source="Assets/PsiSplit.png"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="PsiSplit" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Selective VPN: apps and sites"
                               Style="{StaticResource Muted}" FontSize="11"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" Background="#1B2230" BorderBrush="#2A3242"
                            BorderThickness="1" CornerRadius="16" Padding="10,5"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource MutedBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="VPN off" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="StartButton" Content="Start VPN"
                            Style="{StaticResource PrimaryButton}"
                            Click="StartButton_Click" MinWidth="132"/>
                    <Button x:Name="StopButton" Content="Stop"
                            Style="{StaticResource DangerButton}"
                            Click="StopButton_Click" MinWidth="104"/>
                    <Button x:Name="SiteModeButton" Content="Site mode: off"
                            Style="{StaticResource SecondaryButton}"
                            Click="SiteModeButton_Click" MinWidth="126" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1"
                    Style="{StaticResource MainTabControl}"
                    ItemContainerStyle="{StaticResource TabItemStyle}">

            <!-- ============================= HOME ============================= -->
            <TabItem Header="Home">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,16,0">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Status" Style="{StaticResource H2}"/>
                                        <TextBlock Text="selective mode" HorizontalAlignment="Right"
                                                   FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                    </DockPanel>

                                    <TextBlock x:Name="VpnHeadline" Text="VPN off" FontSize="26"
                                               FontWeight="Bold" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="VpnDetail" Style="{StaticResource Muted}"
                                               FontSize="13" Margin="0,4,0,0"
                                               Text="Psiphon is not running. System proxy settings are unchanged."/>

                                    <ProgressBar x:Name="StartProgress" Height="4" IsIndeterminate="True"
                                                 Visibility="Collapsed" Margin="0,16,0,0"
                                                 Foreground="{StaticResource AccentBrush}"
                                                 Background="#1A2130" BorderThickness="0"/>

                                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"
                                               Text="VPN and Site mode are controlled from the top bar."/>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14,0,14"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Psiphon" Style="{StaticResource Muted}" Margin="0,0,0,7"/>
                                        <TextBlock x:Name="PsiphonEndpointText" Grid.Column="1" Text="—"
                                                   FontFamily="Consolas" FontSize="12" Margin="0,0,0,7"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="1" Text="Full proxy" Style="{StaticResource Muted}" Margin="0,0,0,7"/>
                                        <TextBlock x:Name="FullProxyText" Grid.Row="1" Grid.Column="1" Text="—"
                                                   FontFamily="Consolas" FontSize="12" Margin="0,0,0,7"/>

                                        <TextBlock Grid.Row="2" Text="Filtered proxy" Style="{StaticResource Muted}" Margin="0,0,0,7"/>
                                        <TextBlock x:Name="FilteredProxyText" Grid.Row="2" Grid.Column="1" Text="—"
                                                   FontFamily="Consolas" FontSize="12" Margin="0,0,0,7"/>

                                        <TextBlock Grid.Row="3" Text="PAC" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="PacText" Grid.Row="3" Grid.Column="1" Text="—"
                                                   FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="How it works" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                                               Text="1. Start the VPN - PsiSplit connects using its built-in Psiphon engine."/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                               Text="2. CMD, PowerShell and added apps receive the local proxy address through environment variables."/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                               Text="3. Site mode writes a PAC file to the system settings: in Chrome, only listed sites go through the VPN, everything else goes direct."/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                               Text="4. The built-in engine runs in the background. You do not need to open or install Psiphon."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Quick launch" Style="{StaticResource H2}"/>
                                    <TextBlock Text="Processes receive the PsiSplit proxy instead of the system VPN."
                                               Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14"/>

                                    <Button Content="CMD via VPN" Style="{StaticResource SecondaryButton}"
                                            Click="LaunchCmd_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                    <Button Content="PowerShell via VPN" Style="{StaticResource SecondaryButton}"
                                            Click="LaunchPowerShell_Click" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                    <Button Content="Chrome: listed sites only" Style="{StaticResource SecondaryButton}"
                                            Click="LaunchChrome_Click" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Traffic" Style="{StaticResource H2}"/>
                                        <TextBlock Text="live" HorizontalAlignment="Right"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenBrush}"/>
                                    </DockPanel>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Full proxy" Style="{StaticResource Muted}" FontSize="11"/>
                                        <TextBlock x:Name="FullTrafficText" Grid.Column="1"
                                                   Text="↑ 0 B · ↓ 0 B" TextAlignment="Right"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FullConnectionsText" Grid.Row="1" Grid.Column="1"
                                                   Text="0/0 active · VPN 0 · direct 0" TextAlignment="Right"
                                                   Style="{StaticResource Muted}" FontSize="10"
                                                   Margin="0,2,0,10" TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Row="2" Text="Filtered" Style="{StaticResource Muted}" FontSize="11"/>
                                        <TextBlock x:Name="FilteredTrafficText" Grid.Row="2" Grid.Column="1"
                                                   Text="↑ 0 B · ↓ 0 B" TextAlignment="Right"
                                                   FontFamily="Consolas" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="FilteredConnectionsText" Grid.Row="3" Grid.Column="1"
                                                   Text="0/0 active · VPN 0 · direct 0" TextAlignment="Right"
                                                   Style="{StaticResource Muted}" FontSize="10"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </Grid>

                                    <TextBlock Text="Counted since PsiSplit started"
                                               Style="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Where traffic goes" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"
                                               Text="CMD / PowerShell - all traffic through the VPN (default)."/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                               Text="Apps - depends on the mode: &quot;all traffic&quot; or &quot;listed sites only&quot;."/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                               Text="Chrome / Edge - only listed domains, everything else direct."/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                               Text="Other programs on the computer do not use the VPN."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============================= SITES ============================= -->
            <TabItem Header="Sites">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <TextBlock Text="Sites via VPN" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="SitesCountText" Text="0" HorizontalAlignment="Right"
                                               Style="{StaticResource Muted}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="A domain and all of its subdomains. *.example.com and patterns like *google* are supported."/>
                                <Grid Margin="0,12,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="NewSiteBox" Style="{StaticResource InputStyle}"
                                                 KeyDown="NewSiteBox_KeyDown" TextChanged="NewSiteBox_TextChanged"
                                                 ToolTip="example.com"/>
                                        <TextBlock Text="example.com" IsHitTestVisible="False"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="#6B7280" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewSiteBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Text, ElementName=NewSiteBox}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}"
                                            Click="AddSite_Click" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="SiteStatusText" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,0,0,8"/>
                            </StackPanel>

                            <Grid>
                                <ListBox x:Name="SitesList"
                                         Style="{StaticResource ListBoxStyle}"
                                         ItemContainerStyle="{StaticResource ListItemStyle}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          Click="SiteEnabled_Click" Margin="0,0,10,0"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Pattern}"
                                                           FontFamily="Consolas" FontSize="13"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Content="Delete" Style="{StaticResource DangerButton}"
                                                        Click="RemoveSite_Click" Padding="10,4" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="SitesEmptyText"
                                           Text="The list is empty. Add a domain, for example chatgpt.com."
                                           Style="{StaticResource Muted}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="40" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Site mode" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="System PAC file. Applies to Chrome, Edge and other programs that use the Windows proxy. No browser restart is required."/>
                                <Button x:Name="SiteModeApplyButton" Content="Enable Site mode"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="SiteModeApply_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                                <TextBlock x:Name="SiteModeStatusText" Style="{StaticResource Muted}"
                                           FontSize="11" Margin="0,10,0,0" Text="Disabled."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Formats" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           Text="example.com - the domain itself and all subdomains."/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="*.example.com - subdomains only."/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="*google* - pattern matching any occurrence."/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="You can paste a full URL - the path is dropped automatically."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Domains only" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="PAC filters by site name, not by IP. If a site uses its own CDN domains, add them separately."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================= APPS ============================= -->
            <TabItem Header="Apps">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <DockPanel>
                                    <TextBlock Text="My apps" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="AppsCountText" Text="0" HorizontalAlignment="Right"
                                               Style="{StaticResource Muted}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="The app will receive HTTP_PROXY/HTTPS_PROXY and a --proxy-server argument (for Chromium browsers)."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                                    <Button Content="Add" Style="{StaticResource PrimaryButton}" Click="AddApp_Click"/>
                                    <Button x:Name="EditAppButton" Content="Edit" Style="{StaticResource SecondaryButton}"
                                            Click="EditApp_Click" Margin="8,0,0,0" IsEnabled="False"/>
                                    <Button x:Name="RemoveAppButton" Content="Delete" Style="{StaticResource DangerButton}"
                                            Click="RemoveApp_Click" Margin="8,0,0,0" IsEnabled="False"/>
                                    <Button x:Name="LaunchAppButton" Content="Launch" Style="{StaticResource SecondaryButton}"
                                            Click="LaunchApp_Click" Margin="8,0,0,0" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid>
                                <ListBox x:Name="AppsList"
                                         Style="{StaticResource ListBoxStyle}"
                                         ItemContainerStyle="{StaticResource ListItemStyle}"
                                         SelectionChanged="AppsList_SelectionChanged"
                                         MouseDoubleClick="AppsList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}"
                                                               FontSize="11" FontFamily="Consolas"
                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#1C2432" CornerRadius="10"
                                                        Padding="9,4" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding ModeLabel}" FontSize="10"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AppsEmptyText"
                                           Text="The list is empty. Add a program and it will launch through the VPN."
                                           Style="{StaticResource Muted}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Margin="40" IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Modes" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                           Text="&quot;All traffic&quot; - the app goes fully through Psiphon (Full proxy)."/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="&quot;Listed sites only&quot; - only domains from the &quot;Sites&quot; tab go through Psiphon, everything else goes direct (Filtered proxy)."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Chrome and Edge" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="If the browser is already running without a separate --user-data-dir, the new --proxy-server may be ignored. This does not matter for Site mode: the PAC is picked up on the fly."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Firefox" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="Firefox does not use HTTP_PROXY from the environment. Enable Site mode for it - with the &quot;use system proxy&quot; setting it will use the Windows PAC."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================= LOG ============================= -->
            <TabItem Header="Log">
                <Border Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Event log" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <Button Content="Open logs folder" Style="{StaticResource SecondaryButton}"
                                    Click="OpenLogs_Click" Margin="16,0,0,0" Padding="10,6" FontSize="11"/>
                            <Button Content="Clear" Style="{StaticResource DangerButton}"
                                    Click="ClearLog_Click" Margin="8,0,0,0" Padding="10,6" FontSize="11"/>
                        </StackPanel>

                        <TextBox x:Name="LogBox" IsReadOnly="True" IsUndoEnabled="False"
                                 Background="#0C1017" Foreground="#C9D3E3" BorderThickness="0"
                                 Padding="12" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ============================= SETTINGS ============================= -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,4,0">

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Save settings" Style="{StaticResource H2}"/>
                                    <TextBlock x:Name="SettingsStatusText" HorizontalAlignment="Right"
                                               Style="{StaticResource Muted}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="Changes are applied after saving. Ports cannot be changed while the VPN is connected."/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/>
                                    <Button Content="Restore system proxy" Style="{StaticResource SecondaryButton}" Click="RestoreProxy_Click" Margin="8,0,0,0"/>
                                    <Button Content="Data folder" Style="{StaticResource SecondaryButton}" Click="OpenDataFolder_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Built-in VPN engine" Style="{StaticResource H2}"/>
                                <TextBlock Text="Psiphon is included. No separate installation or application window is needed."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                                <TextBlock x:Name="EngineVersionText" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Local ports" Style="{StaticResource H2}"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                           Text="Changed only while the VPN is stopped. After saving, local servers will be restarted."/>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Full proxy" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox x:Name="FullPortBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Filtered proxy" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox x:Name="FilteredPortBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PAC server" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5"/>
                                        <TextBox x:Name="PacPortBox" Style="{StaticResource InputStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Behavior" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="StartOnLaunchCheck" Content="Connect VPN when PsiSplit starts" Margin="0,12,0,0"/>
                                <CheckBox x:Name="ApplyPacCheck" Content="Enable Site mode automatically after the VPN connects" Margin="0,10,0,0"/>
                                <CheckBox x:Name="StopOnExitCheck" Content="Disconnect VPN when PsiSplit exits" Margin="0,10,0,0"/>
                                <CheckBox x:Name="MinimizeTrayCheck" Content="Minimize to tray on close" Margin="0,10,0,0"/>
                                <CheckBox x:Name="ShellsFilteredCheck" Content="CMD / PowerShell: listed sites only (otherwise all traffic)" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
